{
  "name": "@dymcode/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "copy-widget": "node scripts/copy-widget.mjs",
    "dev": "pnpm --filter @dymcode/widget build && pnpm copy-widget && next dev",
    "build": "pnpm copy-widget && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dymcode/shared": "workspace:*",
    "@paddle/paddle-js": "^1.6.5",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dymcode/db-tests": "workspace:*",
    "@dymcode/widget": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
