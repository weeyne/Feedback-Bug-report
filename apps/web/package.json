{
  "name": "@dymcode/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-widget": "node scripts/copy-widget.mjs",
    "dev": "pnpm --filter @dymcode/widget build && pnpm copy-widget && next dev",
    "build": "pnpm copy-widget && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "telegram:set-webhook": "node scripts/set-telegram-webhook.mjs"
  },
  "dependencies": {
    "@dymcode/shared": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dymcode/db-tests": "workspace:*",
    "@dymcode/widget": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
