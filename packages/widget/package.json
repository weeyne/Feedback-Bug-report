{
  "name": "@bugping/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/ui/mount.ts"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts --configLoader runner",
    "build": "vite build --config vite.screenshot.config.ts && vite build --config vite.widget.config.ts && vite build --config vite.preview.config.ts",
    "size": "size-limit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@bugping/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^24.13.6",
    "happy-dom": "^20.14.5",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0"
  }
}
